<Window x:Class="MarkdownViewer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Markdown Viewer"
        Height="900" Width="1440"
        MinHeight="480" MinWidth="640"
        Background="#0F172A">
    <Grid>
        <!-- Shown until the in-process backend has started and the first navigation completes. -->
        <StackPanel x:Name="LoadingPanel"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Visible">
            <TextBlock Text="Starting Markdown Viewer…"
                       Foreground="#94A3B8"
                       FontFamily="Segoe UI"
                       FontSize="14" />
        </StackPanel>

        <wv2:WebView2 x:Name="WebView" Visibility="Collapsed" />
    </Grid>
</Window>
